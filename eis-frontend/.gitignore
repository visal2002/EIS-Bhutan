# ═══════════════════════════════════════════════════
#  EIS JDMS — Frontend .gitignore
#  Place this at: eis_jdms/frontend/.gitignore
# ═══════════════════════════════════════════════════

# ── Dependencies ─────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Vite cache ───────────────────────────────────────
.vite/